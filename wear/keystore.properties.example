# Copy to keystore.properties (gitignored) to produce a signed release APK.
#
# Generate a keystore with:
#   keytool -genkeypair -v -keystore aibou-release.jks -alias aibou \
#           -keyalg RSA -keysize 4096 -validity 10000
#
# Without this file, assembleRelease still succeeds and emits an
# *unsigned* APK, so the build never hard-depends on local secrets.

storeFile=aibou-release.jks
storePassword=CHANGE_ME
keyAlias=aibou
keyPassword=CHANGE_ME
